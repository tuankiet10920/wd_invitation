{
  "name": "nuxt_seo",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "postbuild": "node ./server/helpers/proccessLessPackage.js && cd ./.output && explorer . && cd ..",
    "dev": "nuxt dev --open",
    "start": "nuxt dev",
    "restart": "PORT=3005 node index.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "build:host": "nuxt build && PORT=3003 && nuxt start",
    "db:migrate:development": "npx sequelize-cli db:migrate --env development --config ./config/config.json",
    "db:migrate:development:one": "npx sequelize-cli db:migrate --env development --config ./config/config.json --to",
    "db:undo:development": "npx sequelize-cli db:migrate:undo:all --env development --config ./config/config.json",
    "db:seed:development": "npx sequelize-cli db:seed:all --env development --config ./config/config.json",
    "db:seed:undo:development": "npx sequelize-cli db:seed:undo:all --env development --config ./config/config.json",
    "db:model:development": "npx sequelize-cli model:generate --env development --config ./config/config.json",
    "db:migrate:test": "npx sequelize-cli db:migrate --env test --config ./config/config.json",
    "db:undo:test": "npx sequelize-cli db:migrate:undo:all --env test --config ./config/config.json",
    "db:seed:test": "npx sequelize-cli db:seed:all --env test --config ./config/config.json",
    "db:seed:undo:test": "npx sequelize-cli db:seed:undo:all --env test --config ./config/config.json",
    "db:model:test": "npx sequelize-cli model:generate --env test --config ./config/config.json",
    "db:migrate:production": "npx sequelize-cli db:migrate --env production --config ./config/config.json",
    "db:undo:production": "npx sequelize-cli db:migrate:undo:all --env production --config ./config/config.json",
    "db:seed:production": "npx sequelize-cli db:seed:all --env production --config ./config/config.json",
    "db:seed:undo:production": "npx sequelize-cli db:seed:undo:all --env production --config ./config/config.json",
    "db:model:production": "npx sequelize-cli model:generate --env production --config ./config/config.json",
    "db:create:model": "npx sequelize-cli model:generate",
    "db:create:seed": "npx sequelize-cli seed:generate",
    "db:reset:production": "npm run db:seed:undo:test && npm run db:undo:test && npm run db:migrate:test && npm run db:seed:test",
    "db:reset:development": "npm run db:seed:undo:development && npm run db:undo:development && npm run db:migrate:development && npm run db:seed:development"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.10",
    "@nuxt/eslint": "^1.11.0",
    "@nuxt/fonts": "^0.12.1",
    "@nuxt/hints": "^1.0.0-alpha.3",
    "@nuxt/icon": "^2.1.1",
    "@nuxt/image": "^2.0.0",
    "@pinia/nuxt": "^0.11.3",
    "@splidejs/vue-splide": "^0.6.12",
    "@vueuse/motion": "^3.0.3",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-vue-next": "^0.40.9",
    "bullmq": "^5.66.4",
    "chart.js": "^4.5.1",
    "eslint": "^9.39.1",
    "html-to-image": "^1.11.13",
    "jsonwebtoken": "^9.0.3",
    "mailgun.js": "^12.5.0",
    "mysql2": "^3.15.3",
    "nodemailer": "^7.0.12",
    "nuxt": "^4.2.1",
    "nuxt-auth-utils": "^0.5.27",
    "nuxt-swiper": "^2.0.1",
    "pinia": "^3.0.4",
    "qrcode.vue": "^3.8.0",
    "resend": "^6.6.0",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "svga.lite": "^1.6.1",
    "uuid": "^13.0.0",
    "vue": "^3.5.25",
    "vue-chartjs": "^5.3.3",
    "vue-easy-lightbox": "^1.19.0",
    "vue-router": "^4.6.3",
    "vue3-moveable": "^0.28.0",
    "vue3-selecto": "^1.12.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^7.0.2",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/hugeicons": "^1.2.22",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/iconoir": "^1.2.10",
    "@iconify-json/lucide": "^1.2.84",
    "@iconify-json/majesticons": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.50",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/mingcute": "^1.2.7",
    "@iconify-json/mynaui": "^1.2.17",
    "@iconify-json/si": "^1.2.17",
    "@iconify-json/simple-icons": "^1.2.66",
    "@iconify-json/solar": "^1.2.5",
    "@iconify-json/tabler": "^1.2.31",
    "@nuxtjs/sitemap": "^7.5.0",
    "@types/bcrypt": "^6.0.0",
    "@types/bootstrap": "^5.2.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.4",
    "nuxt-gtag": "^4.1.0",
    "nuxt-svgo": "^4.2.6",
    "sequelize-cli": "^6.6.3",
    "typescript": "^6.0.2"
  }
}
